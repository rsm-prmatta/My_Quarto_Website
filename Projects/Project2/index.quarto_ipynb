      "source": [
        "#| echo: false\n",
        "\n",
        "import pandas as pd\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "df = sns.load_dataset(\"mpg\").dropna()\n",
        "\n",
        "sns.scatterplot(x=\"mpg\", y=\"displacement\", data=df)\n",
        "plt.show()"
      ],
      "id": "8eb614de",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "The relationship between fuel efficiency (`mpg`) and engine displacement is negative, with a correlation of `{python} float(round(df[\"mpg\"].corr(df[\"displacement\"]), 2))`.\n",
